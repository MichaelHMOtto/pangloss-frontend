import asyncio
import os
import uuid
from pathlib import Path

from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel


PANGLOSS_DIR = "{{ deploy_root }}/pangloss"
BASE_URL = "http://127.0.0.1:{{ api_port }}"
OUTPUT_DIR = Path("{{ app_dir }}/stress-results")
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

TESTS = {
    "http": "tests/test_stress/test_http_stress.py",
    "create": "tests/test_stress/test_create_stress.py",
    "read": "tests/test_stress/test_read_stress.py",
    "complex": "tests/test_stress/test_complex_model_stress.py",
}

jobs = {}
app = FastAPI(title="Pangloss Stress Test Runner")

app.add_middleware(
    CORSMiddleware,
    allow_origins={{ backend_cors_origins | to_json }},
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


class RunRequest(BaseModel):
    suite: str = "complex"
    keyword: str | None = None


async def run_pytest(job_id: str, request: RunRequest):
    test_path = TESTS.get(request.suite)
    if not test_path:
        jobs[job_id]["status"] = "failed"
        jobs[job_id]["output"] = f"Unknown suite: {request.suite}"
        jobs[job_id]["returncode"] = 2
        return

    env = os.environ.copy()
    env["PANGLOSS_TEST_BASE_URL"] = BASE_URL
    env["PANGLOSS_STRESS_OUTPUT_DIR"] = str(OUTPUT_DIR)

    cmd = ["uv", "run", "pytest", test_path, "-m", "stress", "-s"]

    if request.keyword:
        cmd.extend(["-k", request.keyword])

    jobs[job_id]["status"] = "running"
    jobs[job_id]["command"] = " ".join(cmd)

    process = await asyncio.create_subprocess_exec(
        *cmd,
        cwd=PANGLOSS_DIR,
        env=env,
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.STDOUT,
    )

    output, _ = await process.communicate()

    jobs[job_id]["returncode"] = process.returncode
    jobs[job_id]["output"] = output.decode(errors="replace")
    jobs[job_id]["status"] = "passed" if process.returncode == 0 else "failed"


@app.post("/stress/run")
async def start_stress_run(request: RunRequest):
    job_id = str(uuid.uuid4())
    jobs[job_id] = {
        "id": job_id,
        "status": "queued",
        "suite": request.suite,
        "command": None,
        "output": "",
        "returncode": None,
    }

    asyncio.create_task(run_pytest(job_id, request))
    return jobs[job_id]


@app.get("/stress/jobs/{job_id}")
async def get_job(job_id: str):
    if job_id not in jobs:
        raise HTTPException(status_code=404, detail="Unknown job")
    return jobs[job_id]